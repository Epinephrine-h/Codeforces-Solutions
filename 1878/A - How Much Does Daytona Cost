#include <iostream>
#include <algorithm>
 
using namespace std;
 
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int testcase;
    cin >> testcase;
    while(testcase--){
        int n, k;
        bool ok = false;
        cin >> n >> k;
        for (int i = 0; i < n; i++){
            int x;
            cin >> x;
            if (x == k)     ok = true;
        }
        if (ok)     cout << "YES
";
        else    cout << "NO
";
    }
    return 0;
}