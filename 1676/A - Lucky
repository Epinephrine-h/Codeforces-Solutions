#include <iostream>
 
using namespace std;
 
void Answer()
{
    int testcase;
    cin >> testcase;
    while (testcase--)
    {
        string s;
        cin >> s;
        int total = 0, first_three = 0;
        for (int i = 0; i < 6; i++)
            total += (s[i] - '0');
        for (int i = 0; i < 3; i++)
            first_three += (s[i] - '0');
        if (first_three == total - first_three)
            cout << "YES
";
        else
            cout << "NO
";
    }
}
 
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    Answer();
    return 0;
}